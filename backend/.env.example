# Copie ce fichier en ".env" et adapte les valeurs.

# Connexion PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gestionecole

# Clé secrète pour signer les jetons JWT (mets une longue chaîne aléatoire en prod)
SECRET_KEY=change-moi-en-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
